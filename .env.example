# Docker Compose orchestration. Copy to .env and replace every change-me.
# Each variable is explained in docs/setup/infrastructure.md §1.

# Selects server/.env.<APP_ENV>.
APP_ENV=development

# Written by `make clerk-bootstrap-env`.
CLERK_APP_ID=

# Host ports. Change one on a collision, never blank it. Postgres' is
# POSTGRES_PORT in server/.env.development.
WEB_HOST_PORT=3000
API_HOST_PORT=8100

# Empty means the directory name; the example sets it to the app's name. Changing it on a checkout with data points
# Compose at a new, empty database.
COMPOSE_PROJECT_NAME=personal-finance

# Written by `make worktree-init`. Empty in the main checkout.
WORKTREE_SLOT=

GRAFANA_ADMIN_PASSWORD=change-me

# Static domain (bare hostname) and authtoken. See docs/setup/clerk.md §6.
NGROK_DOMAIN=change-me
NGROK_AUTHTOKEN=change-me
