# Root-level environment variables for Docker Compose orchestration.
# Copy to .env and fill in values before running any `docker compose` command.
#
# App/service-specific config lives in:
#   server/.env.*        — FastAPI config (DB, Clerk, LLM, rate limits, …)
#   web-app/.env.local   — Next.js config (NEXT_PUBLIC_* build args, Clerk keys, …)

# Controls which server env file docker-compose.dev.yml loads
# (./server/.env.${APP_ENV:-development})
APP_ENV=development

# Your Clerk development application. Written by `make clerk-bootstrap-env`;
# every other clerk-* target reads it. See docs/setup/clerk.md.
# CLERK_APP_ID=

# Host ports this checkout publishes and runs on. The defaults are usually
# right; set them where they collide. Several projects built from this template
# on one machine: give each its own block of 100 (e.g. 3200 / 3202 / 8300), and
# set ALLOWED_ORIGINS (server/.env.development) and NEXT_PUBLIC_API_URL (both
# portals' .env.local) to match.
# INTERNAL_PORTAL_HOST_PORT=3000
# SUPPLIER_PORTAL_HOST_PORT=3002
# API_HOST_PORT=8100
# POSTGRES_HOST_PORT=5434
# Linked git worktrees follow at base + 10 x slot.

# Compose project. Unset, Compose uses this directory's name. Setting it on a
# checkout that already has data points Compose at a new, empty database
# volume (<project>_postgres-data). Worktrees use <this>-<worktree dir>.
# COMPOSE_PROJECT_NAME=

# Written by `make worktree-init` in a linked worktree, with the ports above.
# Leave unset in the main checkout (slot 0).
# WORKTREE_SLOT=

# Grafana admin password — required by docker-compose.dev.yml (monitoring stack)
GRAFANA_ADMIN_PASSWORD=change-me

NGROK_DOMAIN=xx
NGROK_AUTHTOKEN=xx
