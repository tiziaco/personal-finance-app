{
  "auth_access_control": {
    "sign_up_mode": "public"
  },
  "auth_email": {
    "required_for_sign_up": true,
    "sign_in_strategies": [
      "email_code"
    ],
    "used_for_sign_in": true,
    "used_for_sign_up": true,
    "verification_strategies": [
      "email_code"
    ]
  },
  "auth_multi_factor": {
    "authenticator_app": {
      "enabled": false
    },
    "backup_code": {
      "enabled": false
    },
    "required_for_sign_in": false,
    "required_for_sign_up": false
  },
  "auth_password": {
    "device_trust": {
      "enabled": false
    },
    "disable_hibp": false,
    "enabled": true,
    "enforce_hibp_on_sign_in": false,
    "min_length": 8
  },
  "organization_settings": {
    "enabled": false
  },
  "user_model": {
    "first_name": {
      "enabled": true,
      "required": false
    },
    "last_name": {
      "enabled": true,
      "required": false
    }
  }
}
