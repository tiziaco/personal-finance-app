# Copy to .env.<environment> and replace every change-me.

# Application
APP_ENV=development
# Names the Docker image built by `make -C server docker-build`; not the API title.
PROJECT_NAME="Template Server"
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:8100"]'

# Langfuse
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM. The key is optional: only an LLM call needs it.
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3

# Long-term memory (mem0)
LONG_TERM_MEMORY_MODEL=gpt-5-nano
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory
LONG_TERM_MEMORY_SEARCH_TOP_K=20
LONG_TERM_MEMORY_SEARCH_THRESHOLD=0.1

# Evals (server/evals/). An empty key falls back to OPENAI_API_KEY.
EVALUATION_LLM=gpt-5
EVALUATION_BASE_URL=https://api.openai.com/v1
EVALUATION_API_KEY=
EVALUATION_SLEEP_TIME=10

# Clerk. `make clerk-bootstrap-env` and `make clerk-bootstrap-oauth` write all
# but the webhook secret, which comes from the dashboard (docs/setup/clerk.md).
CLERK_SECRET_KEY=change-me
CLERK_ISSUER=change-me
CLERK_OAUTH_CLIENT_ID=change-me
CLERK_AUTHORIZE_URL=change-me
CLERK_TOKEN_URL=change-me
CLERK_WEBHOOK_SIGNING_SECRET=change-me

# Database. Host and port are the host side; Docker overrides them to db:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate limits
RATE_LIMIT_DEFAULT='["1000 per day", "200 per hour"]'
RATE_LIMIT_CHAT='["100 per minute"]'
RATE_LIMIT_CHAT_STREAM='["100 per minute"]'
RATE_LIMIT_MESSAGES='["200 per minute"]'
RATE_LIMIT_ROOT='["10 per minute"]'
RATE_LIMIT_HEALTH='["60 per minute"]'
RATE_LIMIT_READY='["10 per minute"]'

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_DIR=logs
